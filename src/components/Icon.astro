---
/**
 * The one site at which a Phosphor glyph is inlined (AAP 0.2.3, rule B-1).
 *
 * Four surfaces need an icon and none of them may fetch one: the mobile menu's burger
 * (`list`), the accordion's plus and minus pair, the up-right arrow inside the linked stage
 * card's Cream disc, and the enquiry form's validation and confirmation marks. Each source is
 * imported from the installed `@phosphor-icons/core` package at build time and inlined, so the
 * page carries the drawing itself — no icon font, no icon CDN, no `<use href>` naming another
 * origin (rule B-1), and nothing exported, traced or redrawn from the design reference (rule
 * W-1). The package is the one dependency this file needs and the one it takes.
 *
 * Every use is decorative beside the text that already says the same thing: the menu button,
 * the accordion summary and the field message each carry the words, so the wrapper is hidden
 * from assistive technology (rule B-3). The emitted markup therefore carries no `title`, no
 * `desc` and no `role`, and an icon is never given an accessible name of its own — announcing
 * it twice would be the only thing a name could achieve.
 *
 * The ink is `currentColor`, resolved by whatever text colour the surrounding block sets, so
 * the arrow reads as Chocolate inside its Cream disc and the glyphs on the two dark bands read
 * as Cream, without this component knowing either colour (AAP 0.2.2, 0.6.4, rule B-3). The box
 * is a theme spacing step rather than a length, so the design's master size is `space-24` and
 * nothing here states a value of its own (AAP 0.2.2, 0.6.6).
 *
 * This file makes `src/components` carry 29 files, not the 28 the file lists name: AAP 0.2.3
 * inventories this primitive, and the four consumers above cannot be built without it.
 */
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import checkCircle from '@phosphor-icons/core/assets/regular/check-circle.svg?raw';
import list from '@phosphor-icons/core/assets/regular/list.svg?raw';
import minus from '@phosphor-icons/core/assets/regular/minus.svg?raw';
import plus from '@phosphor-icons/core/assets/regular/plus.svg?raw';
import warningCircle from '@phosphor-icons/core/assets/regular/warning-circle.svg?raw';

/**
 * The glyphs the site's consumers ask for, and nothing else: a union closed to the six names
 * below means a caller cannot request a glyph this file has no source for, and an icon cannot
 * appear on the site without a consumer that needed it. The names are Phosphor's own, so a
 * reader can find the artwork in the package without a mapping table.
 */
type IconName =
  | 'list'
  | 'plus'
  | 'minus'
  | 'arrow-up-right'
  | 'warning-circle'
  | 'check-circle';

/**
 * The three boxes the design scale offers the glyph: the master size the design draws its icon
 * set at, and one step either side of it (AAP 0.2.3, 0.2.2).
 */
type IconSize = 'sm' | 'md' | 'lg';

interface Props {
  /** Which glyph to draw. */
  name: IconName;
  /**
   * The box the glyph fills. `md` is the design's master size and the default, because an icon
   * drawn at the size the design reference sets it is the one case that needs no decision.
   */
  size?: IconSize;
  /**
   * Extra classes for the wrapper, so a consumer can position the glyph in its own layout. It is
   * the only way a caller influences the icon, and it can add a margin or a tint but never a
   * size of its own.
   */
  class?: string;
}

const { name, size = 'md', class: className } = Astro.props;

/**
 * One source per glyph, typed by the union above, so a name added to `IconName` without a
 * source here fails the type check rather than rendering an empty box.
 */
const GLYPHS: Record<IconName, string> = {
  list,
  plus,
  minus,
  'arrow-up-right': arrowUpRight,
  'warning-circle': warningCircle,
  'check-circle': checkCircle,
};

/**
 * The box, from the theme's spacing steps: `space-20`, `space-24` and `space-32`, which is the
 * design's own 24-pixel master between one step either side of it. A size outside the union
 * falls back to the master rather than rendering an unsized box.
 */
const SIZES: Record<IconSize, string> = {
  sm: 'size-20',
  md: 'size-24',
  lg: 'size-32',
};

/**
 * The wrapper is an inline flex box that never shrinks, so a glyph beside a label keeps its
 * square even when the label wraps in a narrow column.
 */
const WRAPPER = 'inline-flex shrink-0';

/** Returns the opening `<svg>` tag, or throws naming the glyph when the source has none. */
function rootTagOf(glyph: IconName, source: string): string {
  const root = /<svg\b[^>]*>/i.exec(source)?.[0];

  if (root === undefined) {
    throw new Error(`Icon: ${glyph}.svg has no root <svg> element to inline.`);
  }

  return root;
}

/** Adds `attribute="value"` to an opening tag that does not already set that attribute. */
function withAttribute(tag: string, attribute: string, value: string): string {
  if (new RegExp(`\\s${attribute}\\s*=`).test(tag)) {
    return tag;
  }

  return tag.replace(/\s*(\/?)>$/, ` ${attribute}="${value}"$1>`);
}

/**
 * Points the drawing at the surrounding text colour. The package's sources declare the ink on
 * their root element, so the declaration is replaced rather than added, and a source that ever
 * arrives without one gains it here; either way the glyph can take no colour of its own.
 */
function withInkFromCurrentColour(tag: string): string {
  const declared = /\sfill\s*=\s*"[^"]*"/i;

  if (declared.test(tag)) {
    return tag.replace(declared, ' fill="currentColor"');
  }

  return withAttribute(tag, 'fill', 'currentColor');
}

/**
 * Prepares a glyph for inline use. The six sources satisfy this contract today; the checks
 * below keep the component's guarantees true if a source changes, and each failure names the
 * glyph so the next reader knows which file to open.
 */
function glyphMarkup(glyph: IconName, source: string): string {
  // The hash-only policy covers elements and not attribute declarations, so a source that sets
  // a presentation value by either route is refused rather than inlined (AAP 0.4.5). The check is
  // on the words, because either route spells one of them and an artwork file has no other
  // reason to.
  if (/\bstyle\b|\bscript\b/i.test(source)) {
    throw new Error(
      `Icon: ${glyph}.svg carries inline style or script, which the content security policy refuses (AAP 0.4.5).`,
    );
  }

  // A reference out of the page would be a runtime request for artwork that is meant to be
  // inlined, and rule B-1 admits none: the glyph has to carry its own paths. A fragment-only
  // target stays inside the document, so it is left alone.
  if (/\s(?:xlink:)?href\s*=\s*["']?(?!#)|\burl\(\s*["']?(?!#)/i.test(source)) {
    throw new Error(
      `Icon: ${glyph}.svg refers to artwork outside itself, which rules out inlining it (rule B-1).`,
    );
  }

  // A colour written into the artwork would survive `currentColor` on the root and render
  // off-palette, so it stops the build instead of reaching a page.
  const offPalette = /\s(?:fill|stroke)\s*=\s*"(?!none"|currentColor")[^"]*"/i.exec(source);

  if (offPalette !== null) {
    throw new Error(
      `Icon: ${glyph}.svg carries a colour of its own (${offPalette[0].trim()}), which no token can tint; the ink has to come from currentColor.`,
    );
  }

  const root = rootTagOf(glyph, source);

  if (!/\sviewBox\s*=/.test(root)) {
    throw new Error(`Icon: ${glyph}.svg has no viewBox, so it cannot scale to its box.`);
  }

  // A fixed width or height in the artwork would fight the wrapper's box, so the tag keeps
  // neither. The attributes below are presentation attributes rather than CSS declarations, so
  // the hash-only policy allows them (AAP 0.4.5), and they hold the drawing at its box even if
  // the wrapper's sizing utility were ever not applied.
  let tag = root.replace(/\s(?:width|height)\s*=\s*"[^"]*"/gi, '');

  tag = withAttribute(tag, 'aria-hidden', 'true');
  tag = withAttribute(tag, 'focusable', 'false');
  tag = withAttribute(tag, 'width', '100%');
  tag = withAttribute(tag, 'height', '100%');
  tag = withAttribute(tag, 'preserveAspectRatio', 'xMidYMid meet');
  tag = withInkFromCurrentColour(tag);

  return source.replace(root, tag);
}

const source: string | undefined = GLYPHS[name];

if (typeof source !== 'string') {
  throw new Error(`Icon: unknown glyph "${String(name)}".`);
}

const markup = glyphMarkup(name, source);

/** The wrapper's class list: the box, its size step, then whatever the consumer adds. */
const extra = typeof className === 'string' ? className.trim() : '';
const sizeClass = SIZES[size] ?? SIZES.md;
const wrapperClass = [WRAPPER, sizeClass, extra].filter(Boolean).join(' ');
---

<span aria-hidden="true" class={wrapperClass}><Fragment set:html={markup} /></span>
