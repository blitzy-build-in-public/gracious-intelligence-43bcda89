# Build-time configuration for the site. All four values are optional and empty by default, are read at
# build time only, and are baked into the emitted HTML, sitemap.xml and robots.txt, so changing any of
# them requires a rebuild. Set but invalid, the first three stop the build and name the variable and the
# rule it broke; PUBLIC_SITE_LIVE never fails the build and only warns. None of these values is a secret.

# PUBLIC_FORM_ENDPOINT: empty, or the enquiry form's absolute URL - https required, http only for localhost or 127.0.0.1; selects the contact form's state; invalid stops the build.
PUBLIC_FORM_ENDPOINT=

# PUBLIC_CONTACT_EMAIL: empty, or exactly one address with no space, comma or question mark; shown in the footer and the contact area and used by the mailto link; invalid stops the build.
PUBLIC_CONTACT_EMAIL=

# PUBLIC_SITE_URL: empty, or the site's absolute origin - https, or http for a local host - with no path beyond /; fills sitemap.xml, og:url and og:image; invalid stops the build.
PUBLIC_SITE_URL=

# PUBLIC_SITE_LIVE: exactly true means live; anything else, including empty, means not live - never a build failure, only a warning naming the value received.
PUBLIC_SITE_LIVE=
