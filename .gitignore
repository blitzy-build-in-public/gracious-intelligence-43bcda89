# Dependencies: installed from the committed lockfile, never committed.
node_modules/

# Build output: dist/ is the publishable artefact and is regenerated by every build.
dist/

# Build output: one root for every per-configuration build (default, live, mailto, screens, flags,
# guard, invalid), for the Playwright runner's traces and failure screenshots, and for the rasteriser's
# fontconfig cache.
.build/

# Build output: Astro's generated types and local preview state, written by sync, check, build and
# preview in every checkout.
.astro/

# Configuration: no credential may enter the repository. .env.example is the only .env* file tracked, and it
# documents the four build-time values, all empty by default.
.env
.env.*
!.env.example

# Review aid: the sixteen review PNGs npm run screenshots writes for design review. Outside version
# control by design, and the test suite asserts that git ignores this folder.
screenshots/

# Generated images: written into public/ by npm run assets on every build and copied from there into the
# published output, so the source tree keeps no raster while every build still publishes the three files.
# Their authored SVG sources stay tracked under src/illustrations/.
public/favicon.svg
public/og-image.png
public/apple-touch-icon.png

# Deliberately not ignored: public/screens/ is the owner's drop point for the three product-screen PNGs
# and its .gitkeep carries the directory, so no pattern here matches that path.
